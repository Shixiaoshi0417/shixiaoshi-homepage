{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shixiaoshi-homepage",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
