{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shixiaoshi-homepage",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
}
